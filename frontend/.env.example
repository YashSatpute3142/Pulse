# Backend origin. Leave empty to use same-origin /api (Vite dev proxy or a Vercel rewrite).
VITE_API_URL=http://localhost:8080
# WebSocket endpoint. Must be an explicit wss:// URL in every production build (the socket cannot go through a rewrite). Empty = same-origin /ws, dev proxy only.
VITE_WS_URL=ws://localhost:8080/ws
